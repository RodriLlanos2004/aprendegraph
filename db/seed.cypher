// AprendeGraph: datos iniciales generados por db/seed.py (no editar a mano)
// Ejecutar después de db/schema.cypher.
MATCH (n) WHERE n:Estudiante OR n:Curso OR n:Tema OR n:Instructor
DETACH DELETE n;

// temas (8)
:param filas => ["Python", "Bases de Datos", "Machine Learning", "Ciberseguridad", "Desarrollo Web", "Cloud", "Estadística", "Redes"];
UNWIND $filas AS nombre MERGE (:Tema {nombre: nombre});

// instructores (6)
:param filas => [{id: "I01", nombre: "Mariana Ortega", especialidad: "Ciencia de datos"}, {id: "I02", nombre: "Javier Cauich", especialidad: "Ingeniería de software"}, {id: "I03", nombre: "Lucía Pech", especialidad: "Seguridad informática"}, {id: "I04", nombre: "Andrés Villanueva", especialidad: "Infraestructura cloud"}, {id: "I05", nombre: "Sofía Canul", especialidad: "Bases de datos"}, {id: "I06", nombre: "Diego Herrera", especialidad: "Desarrollo web"}];
UNWIND $filas AS f
MERGE (i:Instructor {id: f.id}) SET i.nombre = f.nombre, i.especialidad = f.especialidad;

// cursos (20)
:param filas => [{id: "C01", titulo: "Fundamentos de Python", nivel: "Básico", horas: 20, temas: ["Python"], instructor: "I02", descripcion: "Curso de nivel básico de fundamentos de python."}, {id: "C02", titulo: "Python intermedio", nivel: "Intermedio", horas: 25, temas: ["Python"], instructor: "I02", descripcion: "Curso de nivel intermedio de python intermedio."}, {id: "C03", titulo: "Estadística para datos", nivel: "Básico", horas: 18, temas: ["Estadística"], instructor: "I01", descripcion: "Curso de nivel básico de estadística para datos."}, {id: "C04", titulo: "Análisis de datos con Pandas", nivel: "Intermedio", horas: 24, temas: ["Python", "Estadística"], instructor: "I01", descripcion: "Curso de nivel intermedio de análisis de datos con pandas."}, {id: "C05", titulo: "Machine Learning I", nivel: "Intermedio", horas: 30, temas: ["Machine Learning", "Python"], instructor: "I01", descripcion: "Curso de nivel intermedio de machine learning i."}, {id: "C06", titulo: "Deep Learning", nivel: "Avanzado", horas: 36, temas: ["Machine Learning"], instructor: "I01", descripcion: "Curso de nivel avanzado de deep learning."}, {id: "C07", titulo: "SQL desde cero", nivel: "Básico", horas: 16, temas: ["Bases de Datos"], instructor: "I05", descripcion: "Curso de nivel básico de sql desde cero."}, {id: "C08", titulo: "Modelado relacional avanzado", nivel: "Intermedio", horas: 22, temas: ["Bases de Datos"], instructor: "I05", descripcion: "Curso de nivel intermedio de modelado relacional avanzado."}, {id: "C09", titulo: "Bases de datos NoSQL", nivel: "Intermedio", horas: 20, temas: ["Bases de Datos", "Cloud"], instructor: "I05", descripcion: "Curso de nivel intermedio de bases de datos nosql."}, {id: "C10", titulo: "Grafos con Neo4j", nivel: "Avanzado", horas: 18, temas: ["Bases de Datos"], instructor: "I05", descripcion: "Curso de nivel avanzado de grafos con neo4j."}, {id: "C11", titulo: "Fundamentos de redes", nivel: "Básico", horas: 20, temas: ["Redes"], instructor: "I04", descripcion: "Curso de nivel básico de fundamentos de redes."}, {id: "C12", titulo: "Seguridad en redes", nivel: "Intermedio", horas: 24, temas: ["Ciberseguridad", "Redes"], instructor: "I03", descripcion: "Curso de nivel intermedio de seguridad en redes."}, {id: "C13", titulo: "Hacking ético", nivel: "Avanzado", horas: 32, temas: ["Ciberseguridad"], instructor: "I03", descripcion: "Curso de nivel avanzado de hacking ético."}, {id: "C14", titulo: "Operaciones de seguridad (SOC)", nivel: "Avanzado", horas: 28, temas: ["Ciberseguridad", "Cloud"], instructor: "I03", descripcion: "Curso de nivel avanzado de operaciones de seguridad (soc)."}, {id: "C15", titulo: "Introducción a la nube", nivel: "Básico", horas: 15, temas: ["Cloud"], instructor: "I04", descripcion: "Curso de nivel básico de introducción a la nube."}, {id: "C16", titulo: "Arquitectura cloud", nivel: "Intermedio", horas: 26, temas: ["Cloud", "Redes"], instructor: "I04", descripcion: "Curso de nivel intermedio de arquitectura cloud."}, {id: "C17", titulo: "HTML, CSS y JavaScript", nivel: "Básico", horas: 22, temas: ["Desarrollo Web"], instructor: "I06", descripcion: "Curso de nivel básico de html, css y javascript."}, {id: "C18", titulo: "APIs con FastAPI", nivel: "Intermedio", horas: 20, temas: ["Desarrollo Web", "Python"], instructor: "I06", descripcion: "Curso de nivel intermedio de apis con fastapi."}, {id: "C19", titulo: "Despliegue de apps en la nube", nivel: "Avanzado", horas: 18, temas: ["Cloud", "Desarrollo Web"], instructor: "I04", descripcion: "Curso de nivel avanzado de despliegue de apps en la nube."}, {id: "C20", titulo: "Machine Learning en producción", nivel: "Avanzado", horas: 24, temas: ["Machine Learning", "Cloud"], instructor: "I04", descripcion: "Curso de nivel avanzado de machine learning en producción."}];
UNWIND $filas AS f
MERGE (c:Curso {id: f.id})
SET c.titulo = f.titulo, c.nivel = f.nivel, c.horas = f.horas, c.descripcion = f.descripcion
WITH c, f
MATCH (i:Instructor {id: f.instructor}) MERGE (i)-[:IMPARTE]->(c)
WITH c, f
UNWIND f.temas AS tema
MATCH (t:Tema {nombre: tema}) MERGE (c)-[:CUBRE_TEMA]->(t);

// prerrequisitos (20)
:param filas => [{curso: "C02", requiere: "C01"}, {curso: "C04", requiere: "C02"}, {curso: "C04", requiere: "C03"}, {curso: "C05", requiere: "C04"}, {curso: "C06", requiere: "C05"}, {curso: "C08", requiere: "C07"}, {curso: "C09", requiere: "C07"}, {curso: "C10", requiere: "C09"}, {curso: "C12", requiere: "C11"}, {curso: "C13", requiere: "C12"}, {curso: "C13", requiere: "C01"}, {curso: "C14", requiere: "C12"}, {curso: "C16", requiere: "C15"}, {curso: "C16", requiere: "C11"}, {curso: "C18", requiere: "C02"}, {curso: "C18", requiere: "C17"}, {curso: "C19", requiere: "C18"}, {curso: "C19", requiere: "C16"}, {curso: "C20", requiere: "C05"}, {curso: "C20", requiere: "C15"}];
UNWIND $filas AS f
MATCH (c:Curso {id: f.curso}), (p:Curso {id: f.requiere})
MERGE (c)-[:REQUIERE]->(p);

